<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD/UnitCard/UnitCardStyle.uss?fileID=7433441132597879392&amp;guid=e432c72e3524aeb4392fd2d3c4160247&amp;type=3#UnitCardStyle"/>
    <ui:VisualElement name="UnitCard" style="width: 100px; height: 150px; align-self: flex-end; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; flex-shrink: 0; overflow: visible; -unity-background-scale-mode: scale-and-crop; bottom: auto; right: auto; top: auto;">
        <ui:VisualElement name="UnitImage" style="flex-grow: 1; background-image: none; position: absolute; width: 100px; height: 150px; aspect-ratio: auto; top: 0; left: 0;"/>
        <ui:Label text="UnitName" name="UnitNameLabel" style="position: absolute; bottom: auto; right: auto; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 2px; top: 0; left: 0;"/>
        <ui:Label text="SummonCost" name="SummonCostLabel" style="position: absolute; bottom: 22px; right: -21px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 2px;"/>
    </ui:VisualElement>
    <ui:ProgressBar value="0" title="" name="IntervalProgressBar" high-value="100" class="interval-progress-bar" style="position: absolute; bottom: 0; left: 0; width: 100%; right: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 20px;"/>
</ui:UXML>
